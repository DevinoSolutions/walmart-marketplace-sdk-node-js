# ---------------------------------------------------------------------------
# Walmart Marketplace (Global API) credentials — never commit real values.
# Create the key pair in Seller Center → Settings → API Key Management.
# ---------------------------------------------------------------------------
WALMART_CLIENT_ID=YOUR_CLIENT_ID
WALMART_CLIENT_SECRET=YOUR_CLIENT_SECRET
# one of: ca | us | mx | cl  (sent as the WM_MARKET header)
WALMART_MARKET=ca
# Production endpoint; sandbox is https://sandbox.walmartapis.com
WALMART_BASE_URL=https://marketplace.walmartapis.com
# Sent as WM_SVC.NAME on every call; identifies this integration in Walmart's logs.
WALMART_SVC_NAME=devino-walmart-sdk

# ---------------------------------------------------------------------------
# Live smoke tests (opt-in; NEVER run in CI). The live suite is READ-ONLY — it performs no
# writes to your account, and `npm run check:live-readonly` fails the build if a mutating
# call is ever added to packages/sdk/test/live/. Run:
#   WALMART_LIVE_TESTS=true npm run test:live
# ---------------------------------------------------------------------------
WALMART_LIVE_TESTS=false
# Optional: an existing feed id to exercise the READ-ONLY feeds.getStatus live test.
# Leave empty and that test skips cleanly.
WALMART_LIVE_TEST_FEED_ID=
